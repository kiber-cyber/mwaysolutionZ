NEXT_PUBLIC_SITE_URL=https://mwaysolutions.net

EMAIL_FROM="MWAY Solutions <info@mwaysolutions.net>"
EMAIL_TO=info@mwaysolutions.net

# Set automatically by the Vercel <-> Resend integration you already connected.
# Verify it exists under Project Settings -> Environment Variables (Production)
# rather than re-creating it.
RESEND_API_KEY=

# Cloudflare Turnstile -- NEXT_PUBLIC_TURNSTILE_SITE_KEY is public (client widget).
# TURNSTILE_SECRET_KEY must stay server-only -- never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
